# Postgres
DATABASE_URL=postgres://deye:deye@localhost:5432/deye

# Redis (BullMQ workers)
REDIS_URL=redis://localhost:6379

# Auth / session cookie (iron-session). Min 32 characters.
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# At-rest encryption for vendor credentials and Telegram bot tokens (min 16 chars)
ENCRYPTION_KEY=change-me-encryption-key-16+

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
